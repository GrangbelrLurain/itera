# Copy to .env and fill in. Never commit .env (the repository ignores it).

# From the Cloudflare dashboard: Zero Trust > Networks > Tunnels > your tunnel (a secret: anyone with it can run the tunnel).
TUNNEL_TOKEN=

# The demo account. Visitors are told this password on the login page, so choose a throwaway one that you use nowhere else.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-demo
# Signs the login tokens. Any long random string, for example: openssl rand -hex 32
ADMIN_TOKEN_SECRET=

# Shown on the login page. Say which account to use (the real password, keep it in sync with ADMIN_PASSWORD) and when
# the data resets.
DEMO_NOTICE=데모 환경입니다. 계정 admin / 비밀번호 change-me-demo 로 로그인하세요. 데이터는 6시간마다 샘플 상태로 초기화됩니다.

# Optional
# MEMORY_RESET_INTERVAL=PT6H
# RATE_LIMIT_READS_PER_MINUTE=120
# RATE_LIMIT_WRITES_PER_MINUTE=30
# ITERA_TAG=latest     # or a version such as 0.1.0
